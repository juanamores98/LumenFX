<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net35</TargetFramework>
        <AssemblyName>LumenFX</AssemblyName>
        <RootNamespace>LumenFX</RootNamespace>
        <LangVersion>7.3</LangVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Product>LumenFX</Product>
        <Version>1.0.0</Version>
        <ManagedDLLPath>$(MSBuildProgramFiles32)/Steam/steamapps/common/Cities_Skylines/Cities_Data/Managed</ManagedDLLPath>
        <FrameworkPathOverride>$(ManagedDLLPath)</FrameworkPathOverride>
        <AssemblySearchPaths>$(AssemblySearchPaths);$(ManagedDLLPath)</AssemblySearchPaths>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp" />
        <Reference Include="ColossalManaged" />
        <Reference Include="ICities" />
        <Reference Include="UnityEngine" />
        <Reference Include="0Harmony">
            <HintPath>lib\0Harmony.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <Target Name="DeployToModDirectory" AfterTargets="Build">
        <PropertyGroup>
            <DeployDir>$(LOCALAPPDATA)/Colossal Order/Cities_Skylines/Addons/Mods/LumenFX/</DeployDir>
        </PropertyGroup>
        <MakeDir Directories="$(DeployDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
        <Copy SourceFiles="$(TargetDir)0Harmony.dll" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
        <Message Importance="high" Text="Deployed to $(DeployDir)" />
    </Target>

</Project>
